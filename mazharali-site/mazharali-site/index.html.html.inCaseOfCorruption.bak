                    <h4 class="font-bold text-lg mb-4">خدمة العملاء</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="#" class="hover:text-primary transition">حسابي</a></li>
                        <li><a href="#" class="hover:text-primary transition">تتبع الطلب</a></li>
                        <li><a href="#" class="hover:text-primary transition">سياسة الإرجاع</a></li>
                        <li><a href="#" class="hover:text-primary transition">شروط الاستخدام</a></li>
                        <li><a href="#" class="hover:text-primary transition">سياسة الخصوصية</a></li>
                        <li><a href="#" class="hover:text-primary transition">الدعم الفني</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold text-lg mb-4">تواصل معنا</h4>
                    <ul class="space-y-3 text-gray-400 text-sm">
                        <li class="flex items-start gap-3">
                            <i class="fas fa-map-marker-alt text-primary mt-1"></i>
                            <span>القاهرة، جمهورية مصر العربية</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fas fa-phone-alt text-primary"></i>
                            <span>0155xxxxxxx</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fas fa-envelope text-primary"></i>
                            <span>info@mazharali.com</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fas fa-clock text-primary"></i>
                            <span>الأحد - الخميس: 9 ص - 11 م</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-white/10 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="text-gray-400 text-sm">© 2026 مظهر علي. جميع الحقوق محفوظة.</p>
                <div class="flex items-center gap-4">
                    <i class="fab fa-cc-visa text-3xl text-gray-400"></i>
                    <i class="fab fa-cc-mastercard text-3xl text-gray-400"></i>
                    <i class="fab fa-cc-paypal text-3xl text-gray-400"></i>
                    <i class="fab fa-cc-apple-pay text-3xl text-gray-400"></i>
                </div>
            </div>
        </div>
    </footer>

    <!-- Cart Sidebar -->
    <div id="cart-sidebar" class="fixed top-0 left-0 h-full w-80 bg-white shadow-2xl z-50 transform -translate-x-full transition-transform duration-300">
        <div class="p-4 border-b flex items-center justify-between">
            <h3 class="font-bold text-lg">سلة التسوق</h3>
            <button onclick="toggleCart()" class="w-8 h-8 hover:bg-gray-100 rounded-full flex items-center justify-center transition"><i class="fas fa-times"></i></button>
        </div>
        <div id="cart-items" class="p-4 space-y-4 overflow-y-auto h-[calc(100%-140px)]">
            <div class="text-center text-gray-400 py-8">
                <i class="fas fa-shopping-basket text-4xl mb-2"></i>
                <p>السلة فارغة</p>
            </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-4 border-t bg-white">
            <div class="flex justify-between mb-3 font-bold">
                <span>المجموع:</span>
                <span id="cart-total">0 ج.م</span>
            </div>
            <button class="w-full bg-primary text-secondary py-3 rounded-lg font-bold hover:bg-yellow-400 transition">إتمام الشراء</button>
        </div>
    </div>
    <div id="cart-overlay" onclick="toggleCart()" class="fixed inset-0 bg-black/50 z-40 hidden"></div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-secondary text-white px-6 py-3 rounded-lg shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center gap-3">
        <i class="fas fa-check-circle text-primary"></i>
        <span id="toast-msg">تمت الإضافة للسلة!</span>
    </div>

    <script>
        // Slider
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.dot');

        function showSlide(n) {
            slides.forEach(s => s.classList.remove('active'));
            dots.forEach(d => d.classList.remove('active', 'bg-primary'));
            currentSlide = (n + slides.length) % slides.length;
            slides[currentSlide].classList.add('active');
            dots[currentSlide].classList.add('active', 'bg-primary');
        }

        function changeSlide(n) { showSlide(currentSlide + n); }
        function goToSlide(n) { showSlide(n); }
        setInterval(() => changeSlide(1), 5000);

        // Countdown
        function updateCountdown() {
            const now = new Date();
            const end = new Date();
            end.setHours(23, 59, 59);
            let diff = end - now;
            if (diff < 0) diff = 0;
            const h = Math.floor(diff / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            const s = Math.floor((diff % 60000) / 1000);
            document.getElementById('hours').textContent = String(h).padStart(2, '0');
            document.getElementById('minutes').textContent = String(m).padStart(2, '0');
            document.getElementById('seconds').textContent = String(s).padStart(2, '0');
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Cart
        let cart = [];
        function toggleCart() {
            const sidebar = document.getElementById('cart-sidebar');
            const overlay = document.getElementById('cart-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        function addToCart() {
            cart.push({ name: 'منتج جديد', price: 199 });
            document.getElementById('cart-count').textContent = cart.length;
            showToast('تمت إضافة المنتج إلى السلة!');
            updateCartItems();
        }

        function updateCartItems() {
            const container = document.getElementById('cart-items');
            if (cart.length === 0) {
                container.innerHTML = '<div class="text-center text-gray-400 py-8"><i class="fas fa-shopping-basket text-4xl mb-2"></i><p>السلة فارغة</p></div>';
                document.getElementById('cart-total').textContent = '0 ج.م';
                return;
            }
            let html = '';
            let total = 0;
            cart.forEach((item, i) => {
                total += item.price;
                html += `<div class="flex items-center gap-3 bg-gray-50 p-3 rounded-lg">
                    <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center"><i class="fas fa-box text-gray-400"></i></div>
                    <div class="flex-1"><p class="text-sm font-bold">${item.name}</p><p class="text-xs text-gray-500">${item.price} ج.م</p></div>
                    <button onclick="removeFromCart(${i})" class="text-gray-400 hover:text-accent"><i class="fas fa-trash-alt"></i></button>
                </div>`;
            });
            container.innerHTML = html;
            document.getElementById('cart-total').textContent = total + ' ج.م';
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            document.getElementById('cart-count').textContent = cart.length;
            updateCartItems();
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
        }
    </script>
</body>
</html>